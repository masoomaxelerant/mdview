{
  "name": "mdfileview",
  "version": "1.0.3",
  "description": "A standalone viewer for Markdown files — opens .md files directly in rendered view, like a PDF reader.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "release:mac": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.mdfileview.app",
    "productName": "MDView",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown File",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown File",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "masoomaxelerant",
        "repo": "mdview",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "keywords": ["markdown", "viewer", "md", "reader"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
